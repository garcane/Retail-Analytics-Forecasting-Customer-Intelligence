# Local DuckDB warehouse is rebuilt from data/ + sql/ by src/transformation/build_warehouse.py
*.duckdb
*.duckdb.wal

# Raw Olist dataset (Kaggle, CC BY-NC-SA 4.0): re-downloadable, not stored in Git
data/
# ...but the HTML dashboard's data files are small aggregates (no order-level rows, no review text): keep them
!dashboard/data/

# Secrets and credentials (none are expected in this local-only project)
.env
.env.*
!.env.example
*.pem
*.key
# Snowflake key-pair authentication: PKCS#8 private keys are normally .p8 files
*.p8
*.p12
*.pfx
rsa_key*
*service-account*.json
*credentials*.json

__pycache__/
.ipynb_checkpoints/

# graphify: keep the graph and report, not its cache or dated backups (regenerated by `graphify update .`)
graphify-out/cache/
graphify-out/20*/

# Power BI: exported data is regenerable (src/powerbi/export_data.py); local Power BI state is per-user
powerbi/data/
**/.pbi/

# marimo session caches (cell outputs, regenerated on every run)
__marimo__/

# Snowflake/dbt implementation: patched Power BI copy (apply_snowflake_source.py) and local tool caches
powerbi_snowflake/
.ruff_cache/
