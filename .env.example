# Template for the environment variables used by the Snowflake + dbt implementation.
#
# Names and placeholders only. Never put real values in this file. Copy it to a git-ignored file
# (.env or .env.retail; both match the .gitignore patterns ".env" and ".env.*") and fill in the copy.
# The real file is never committed. Nothing in the repository loads a .env file automatically: export
# the variables into your shell first (see snowflake/README.md, step 2).
#
# Nothing here is needed for the DuckDB path, which is the default (DATA_BACKEND=duckdb).
# Status: written offline; no value below has been used against a live Snowflake account.

# --- Which backend the Python code reads from -------------------------------------------------
# duckdb (default) | snowflake
DATA_BACKEND=duckdb
# DuckDB reference warehouse (opened read-only). Default: warehouse.duckdb in the repo root.
# DUCKDB_PATH=<path to warehouse.duckdb>

# --- Snowflake connection (key-pair authentication only; no passwords) ------------------------
# Account identifier, for example <orgname>-<account_name> or <locator>.<region>. Not a URL.
SNOWFLAKE_ACCOUNT=<account_identifier>
SNOWFLAKE_USER=<snowflake_user>
# Path to your PKCS#8 private key file (.p8). The file itself must stay outside the repository.
SNOWFLAKE_PRIVATE_KEY_PATH=<path_to_private_key.p8>
# Only if the key is encrypted; leave unset (or empty) for an unencrypted key.
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=<key_passphrase>

# --- Project objects (defaults shown; override only if your names differ) ----------------------
# Role used by dbt, Python and reconciliation. The RAW loader defaults to RETAIL_LOADER on its own:
# do NOT set this to RETAIL_TRANSFORMER while running snowflake/ingestion/load_raw.py (it cannot
# write to RAW); pass --role RETAIL_LOADER or leave this unset for the load.
# RETAIL_SF_ROLE=RETAIL_TRANSFORMER
# RETAIL_SF_WAREHOUSE=RETAIL_WH
# RETAIL_SF_DATABASE=RETAIL_OLIST

# --- Safety gates ------------------------------------------------------------------------------
# Python data access opens a live Snowflake connection only with confirm=True or RETAIL_SF_CONFIRM=1
# (only the exact value 1 counts). Leave this unset until you have checked the printed target.
# RETAIL_SF_CONFIRM=1
# Opt-in write of forecast and score tables to the ML schema (Snowflake backend only). Off by default.
# FORECAST_WRITEBACK=1

# --- Data and dbt ------------------------------------------------------------------------------
# Folder holding the nine Olist CSV files (default: ./data, then an error naming the folder).
RETAIL_DATA_DIR=<path_to_folder_with_the_nine_csv_files>
# Prefix for the dbt dev/ci schemas, giving <SUFFIX>_STAGING, <SUFFIX>_MARTS, and so on.
# dbt defaults: DBT_DEV for target dev, DBT_CI for target ci. The prod target ignores it.
# DBT_DEV_SUFFIX=<your_initials>

# --- Optional ----------------------------------------------------------------------------------
# Warehouse file used by the optional real-warehouse tests in tests/test_reconciliation.py.
# RECON_WAREHOUSE=<path to warehouse.duckdb>
