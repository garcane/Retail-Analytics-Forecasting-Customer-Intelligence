{
  "permissions": {
    "allow": [
      "ClaudeInChromeDomain(app.snowflake.com)",
      "ClaudeInChromeDomain(github.com)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "ClaudeInChromeDomain(www.linkedin.com)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard search",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Read|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "graphify hook-guard read",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
